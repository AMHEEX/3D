    "saudacao": [
      "Oi! Eu sou a **AMHEEX AI**. O mundo está aberto: chão verde e a bola vermelha. O que eu construo para você?",
      "Olá! AMHEEX AI pronta. Peça um personagem realista, um mapa, um jogo inteiro ou ative o multiplayer.",
      "Oi! Fale ou escreva: “crie game” ou “crie um personagem realista”."
    ],
    "criar": [
      "Pronto! Criei {n} {ent} {onde}. Quer que eu adicione mais alguma coisa?",
      "Feito: {n} {ent} {onde}, na cor {cor}. Posso montar uma vila em volta.",
      "Adicionei {n} {ent} {onde}. Dá para pedir “pinte de azul” ou “aumente”."
    ],
    "criar_livre": [
      "Não tinha {nome} no meu catálogo, então criei do zero: {n} {nome} em forma de {forma}, {onde}. Ficou bom?",
      "Criei {n} {nome} {onde} usando geometria {forma}. Peça “maior”, “de outra cor” ou “gire” para ajustar.",
      "Feito! {n} {nome} {onde}. Eu invento a forma quando não conheço o objeto — agora ele existe no mundo."
    ],
    "layout": [
      "Adicionei {item} na tela: “{texto}”. Quer mudar a posição ou a cor?",
      "Elemento de layout criado: {item} com o texto “{texto}”.",
      "Pronto, {item} apareceu no HUD. Posso colocar no topo, na base, à esquerda ou à direita."
    ],
    "avatar": [
